# Zepto Data & AI Platform Environment Configuration

# Database Configuration
DATABASE_URL=sqlite:///./zepto_platform.db
# POSTGRES_URL=postgresql://user:password@localhost:5432/zepto_db

# LLM & RAG Provider Keys
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=gemini  # Options: gemini, openai, local

# Vector Database Config
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_DIR=./support_assistant/faiss_index

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
